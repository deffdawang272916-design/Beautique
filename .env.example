# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMS PROVIDER CONFIGURATION
# Options: "mock" (default for development/testing), "semaphore" (Philippine SMS gateway), "webhook"
SMS_PROVIDER="mock"

# Semaphore SMS Gateway Credentials (when SMS_PROVIDER="semaphore")
SEMAPHORE_API_KEY="MY_SEMAPHORE_API_KEY"
SEMAPHORE_SENDER_NAME="BEAUTIQUE"

# Generic Webhook SMS Gateway (when SMS_PROVIDER="webhook")
SMS_WEBHOOK_URL="https://example.com/api/sms/send"
SMS_WEBHOOK_SECRET="MY_WEBHOOK_SIGNATURE_SECRET"

# STAFF AUTHENTICATION
# Required for staff review, appointment confirmation, rescheduling, and cancellation
STAFF_API_KEY="beautique-staff-demo-2026"

# CLINIC NOTIFICATION WEBHOOK (Optional)
# Forwards appointment and inquiry events to clinic Telegram/Discord/Slack webhook
CLINIC_NOTIFICATION_WEBHOOK_URL=""
